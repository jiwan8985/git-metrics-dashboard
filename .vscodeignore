# Development tools
.vscode/**
.vscode-test/**
.vscode-test/
.idea/**

# Source TypeScript (compiled output in out/ is included)
src/**

# Test & coverage
coverage/**
**/__tests__/**
**/test/**
jest.config.js
.nycrc

# Build artifacts to exclude
**/*.map
**/*.ts
!out/**/*.js

# Reports generated during development
git-metrics-reports/**

# Lock files
package-lock.json
yarn.lock

# Config files not needed at runtime
**/tsconfig.json
**/eslint.config.mjs
**/.eslintrc.json
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/.vscode-test.*

# Internal development docs (not for end users)
CLAUDE.md
AGENTS.md
docs/**
.github/**

# VSIX artifacts
*.vsix

tsconfig.integration.json
out-integration/**
tmp/**

{
  "name": "git-metrics-dashboard",
  "displayName": "Git Metrics Dashboard",
  "description": "Repository intelligence for VS Code: Git health score, risk detection, refactor radar, contributor analytics, and shareable executive reports.",
  "version": "0.2.5",
  "publisher": "jiwan-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiwan8985/git-metrics-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/jiwan8985/git-metrics-dashboard/issues"
  },
  "homepage": "https://github.com/jiwan8985/git-metrics-dashboard#readme",
  "author": {
    "name": "jiwan",
    "email": "jiwan8985@gmail.com"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "metrics",
    "dashboard",
    "analytics",
    "statistics",
    "commits",
    "contributors",
    "analysis",
    "report",
    "export",
    "csv",
    "json",
    "html",
    "markdown",
    "visualization",
    "github",
    "git-log",
    "repository",
    "productivity",
    "team-metrics",
    "code-review",
    "repository-health",
    "engineering-intelligence",
    "technical-debt",
    "refactor",
    "churn",
    "manager-report",
    "badges",
    "achievements",
    "dark-theme",
    "light-theme"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:gitMetrics",
    "onCommand:gitMetrics.showDashboard",
    "onCommand:gitMetrics.refreshTreeView",
    "onCommand:gitMetrics.quickExport",
    "onCommand:gitMetrics.customExport",
    "onCommand:gitMetrics.openPrivacySecurity",
    "onCommand:gitMetrics.openSupport",
    "onCommand:gitMetrics.windowsTroubleshoot",
    "onCommand:gitMetrics.copyReadmeBadge",
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitMetricsContainer",
          "title": "Git Metrics",
          "icon": "images/icon-sidebar.svg"
        }
      ]
    },
    "views": {
      "gitMetricsContainer": [
        {
          "id": "gitMetrics",
          "name": "Git Metrics",
          "icon": "images/icon-sidebar.svg",
          "contextualTitle": "Git Metrics Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "gitMetrics.showDashboard",
        "title": "Open Dashboard",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.quickExport",
        "title": "Quick Export Report",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.customExport",
        "title": "Custom Export Report",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.openReportsFolder",
        "title": "Open Reports Folder",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.toggleTheme",
        "title": "Toggle Theme",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.refreshTreeView",
        "title": "Refresh",
        "category": "Git Metrics",
        "icon": "$(refresh)"
      },
      {
        "command": "gitMetrics.changeLanguage",
        "title": "Change Language",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.openPrivacySecurity",
        "title": "Open Privacy & Security Notes",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.openSupport",
        "title": "Open Support Guide",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.windowsTroubleshoot",
        "title": "Run Windows Troubleshooter",
        "category": "Git Metrics"
      },
      {
        "command": "gitMetrics.copyReadmeBadge",
        "title": "Copy README Badge",
        "category": "Git Metrics"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitMetrics.showDashboard",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitMetrics.quickExport",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitMetrics.customExport",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitMetrics.openReportsFolder",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitMetrics.toggleTheme",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitMetrics.openPrivacySecurity"
        },
        {
          "command": "gitMetrics.openSupport"
        }
      ],
      "view/title": [
        {
          "command": "gitMetrics.showDashboard",
          "when": "view == gitMetrics",
          "group": "navigation"
        },
        {
          "command": "gitMetrics.refreshTreeView",
          "when": "view == gitMetrics",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "gitMetrics.showDashboard",
          "group": "gitmetrics@1"
        },
        {
          "command": "gitMetrics.quickExport",
          "group": "gitmetrics@2"
        },
        {
          "command": "gitMetrics.customExport",
          "group": "gitmetrics@3"
        },
        {
          "command": "gitMetrics.toggleTheme",
          "group": "gitmetrics@4"
        }
      ]
    },
    "configuration": {
      "title": "Git Metrics Dashboard",
      "properties": {
        "gitMetrics.defaultPeriod": {
          "type": "number",
          "default": 30,
          "description": "Default analysis period in days",
          "minimum": 1,
          "maximum": 365
        },
        "gitMetrics.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time Git change detection and auto-refresh"
        },
        "gitMetrics.showAuthorStats": {
          "type": "boolean",
          "default": true,
          "description": "Show per-author statistics in the dashboard"
        },
        "gitMetrics.maxTopFiles": {
          "type": "number",
          "default": 10,
          "description": "Number of top files to display",
          "minimum": 5,
          "maximum": 50
        },
        "gitMetrics.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Dashboard theme",
          "enumDescriptions": [
            "Follow VS Code theme automatically",
            "Force light theme",
            "Force dark theme"
          ]
        },
        "gitMetrics.export.defaultFormat": {
          "type": "string",
          "enum": [
            "html",
            "json",
            "csv",
            "markdown"
          ],
          "default": "html",
          "description": "Default report export format"
        },
        "gitMetrics.export.includeSummary": {
          "type": "boolean",
          "default": true,
          "description": "Include summary statistics in reports"
        },
        "gitMetrics.export.includeAuthorStats": {
          "type": "boolean",
          "default": true,
          "description": "Include per-author statistics in reports"
        },
        "gitMetrics.export.includeFileStats": {
          "type": "boolean",
          "default": true,
          "description": "Include file type analysis in reports"
        },
        "gitMetrics.export.includeTimeAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Include time pattern analysis in reports"
        },
        "gitMetrics.export.autoOpenAfterExport": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the file after export"
        },
        "gitMetrics.export.customReportsPath": {
          "type": "string",
          "default": "",
          "description": "Custom path for saving reports (defaults to <workspace>/git-metrics-reports)"
        },
        "gitMetrics.export.useThemeInReports": {
          "type": "boolean",
          "default": true,
          "description": "Apply current VS Code theme to HTML reports"
        },
        "gitMetrics.autoRefreshInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Git change detection interval in milliseconds (requires autoRefresh enabled)"
        },
        "gitMetrics.showChangeNotification": {
          "type": "boolean",
          "default": false,
          "description": "Show notification message when Git changes are detected"
        },
        "gitMetrics.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko",
            "ja",
            "zh-CN"
          ],
          "default": "auto",
          "description": "Dashboard display language (auto follows VS Code language setting)",
          "enumDescriptions": [
            "Auto-detect from VS Code language setting",
            "English",
            "한국어",
            "日本語",
            "简体中文"
          ]
        }
      }
    },
    "keybindings": [
      {
        "command": "gitMetrics.showDashboard",
        "key": "ctrl+shift+g ctrl+shift+d",
        "mac": "cmd+shift+g cmd+shift+d",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "gitMetrics.quickExport",
        "key": "ctrl+shift+g ctrl+shift+e",
        "mac": "cmd+shift+g cmd+shift+e",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "gitMetrics.toggleTheme",
        "key": "ctrl+shift+g ctrl+shift+t",
        "mac": "cmd+shift+g cmd+shift+t",
        "when": "workspaceFolderCount > 0"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "node node_modules/eslint/bin/eslint.js src",
    "test:unit": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:integration": "vscode-test",
    "test": "npm run test:unit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.19.0",
    "eslint": "^9.25.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.3"
  }
}
